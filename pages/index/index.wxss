.hero-section {
  text-align: center;
  padding: 40rpx 0;
}

.hero-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.input-section {
  margin-bottom: 40rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.settings-section {
  margin-bottom: 40rpx;
}

.settings-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.setting-item {
  margin-bottom: 30rpx;
}

.setting-item:last-child {
  margin-bottom: 0;
}

.setting-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  display: block;
}

.setting-options {
  display: flex;
  gap: 20rpx;
}

.setting-option {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s ease;
}

.setting-option.selected {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
}

.hot-topics {
  margin-bottom: 30rpx;
}

.hot-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.topic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.topic-tag {
  padding: 16rpx 28rpx;
  background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #92400e;
}

.start-btn {
  padding: 32rpx;
  font-size: 36rpx;
}

.features-card {
  padding: 40rpx;
}

.features-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.features-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: rgba(102, 126, 234, 0.05);
  border-radius: 16rpx;
}

.feature-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.feature-content {
  flex: 1;
}

.feature-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  font-size: 24rpx;
  color: #999;
}