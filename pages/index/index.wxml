<view class="container">
  <view class="card">
    <view class="hero-section">
      <view class="hero-icon">📚</view>
      <view class="title">学习英雄</view>
      <view class="subtitle">AI问答引导式学习，让知识闯关更有趣！</view>
    </view>

    <view class="input-section">
      <view class="input-label">学习主题</view>
      <input 
        class="input" 
        placeholder="输入你想学习的主题，如：Python编程、历史知识..." 
        value="{{topic}}"
        bindinput="onTopicInput"
        bindconfirm="startQuiz"
      />
    </view>

    <view class="settings-section">
      <view class="settings-title">答题设置</view>
      <view class="setting-item">
        <text class="setting-label">题目数量</text>
        <view class="setting-options">
          <view 
            wx:for="{{questionCountOptions}}" 
            wx:key="value"
            class="setting-option {{questionCount === item.value ? 'selected' : ''}}"
            bindtap="setQuestionCount"
            data-value="{{item.value}}"
          >
            {{item.label}}
          </view>
        </view>
      </view>
      <view class="setting-item">
        <text class="setting-label">难度等级</text>
        <view class="setting-options">
          <view 
            wx:for="{{difficultyOptions}}" 
            wx:key="value"
            class="setting-option {{difficulty === item.value ? 'selected' : ''}}"
            bindtap="setDifficulty"
            data-value="{{item.value}}"
          >
            {{item.label}}
          </view>
        </view>
      </view>
    </view>

    <view class="hot-topics">
      <view class="hot-title">🔥 热门主题</view>
      <view class="topic-tags">
        <view 
          wx:for="{{hotTopics}}" 
          wx:key="name"
          class="topic-tag"
          bindtap="selectHotTopic"
          data-topic="{{item.name}}"
        >
          {{item.icon}} {{item.name}}
        </view>
      </view>
    </view>

    <view 
      class="btn-primary start-btn" 
      bindtap="startQuiz"
      style="margin-top: 40rpx;"
    >
      🚀 开始闯关
    </view>
  </view>

  <view class="card features-card">
    <view class="features-title">✨ 功能特点</view>
    <view class="features-list">
      <view class="feature-item">
        <view class="feature-icon">🤖</view>
        <view class="feature-content">
          <view class="feature-name">AI智能出题</view>
          <view class="feature-desc">围绕主题智能生成趣味问答</view>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-icon">🎮</view>
        <view class="feature-content">
          <view class="feature-name">闯关模式</view>
          <view class="feature-desc">游戏化学习，轻松掌握知识</view>
        </view>
      </view>
      <view class="feature-item">
        <view class="feature-icon">📊</view>
        <view class="feature-content">
          <view class="feature-name">成绩分析</view>
          <view class="feature-desc">详细的答题报告和学习建议</view>
        </view>
      </view>
    </view>
  </view>
</view>