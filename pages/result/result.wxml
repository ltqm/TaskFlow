<view class="container">
  <view class="card result-card">
    <view class="result-icon">{{resultIcon}}</view>
    <view class="result-title">{{resultTitle}}</view>
    <view class="result-subtitle">「{{topic}}」闯关完成</view>

    <view class="score-section">
      <view class="score-circle">
        <view class="score-number">{{score}}</view>
        <view class="score-label">得分</view>
      </view>
      <view class="score-info">
        <view class="info-item">
          <text class="info-label">总题数</text>
          <text class="info-value">{{count}} 题</text>
        </view>
        <view class="info-item">
          <text class="info-label">正确率</text>
          <text class="info-value">{{accuracy}}%</text>
        </view>
        <view class="info-item">
          <text class="info-label">评级</text>
          <text class="info-value grade">{{grade}}</text>
        </view>
      </view>
    </view>

    <view class="stats-section">
      <view class="stat-item">
        <view class="stat-icon">✅</view>
        <view class="stat-content">
          <view class="stat-value correct">{{correctCount}}</view>
          <view class="stat-label">正确</view>
        </view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-icon">❌</view>
        <view class="stat-content">
          <view class="stat-value wrong">{{wrongCount}}</view>
          <view class="stat-label">错误</view>
        </view>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <view class="stat-icon">⚡</view>
        <view class="stat-content">
          <view class="stat-value">{{score}}</view>
          <view class="stat-label">积分</view>
        </view>
      </view>
    </view>

    <view class="encourage-section">
      <view class="encourage-text">{{encourageMessage}}</view>
    </view>

    <view class="action-buttons">
      <view class="btn-primary" bindtap="restartQuiz">
        🔄 再来一次
      </view>
      <view class="btn-secondary" bindtap="goHome">
        🏠 返回首页
      </view>
    </view>
  </view>

  <view class="card tips-card">
    <view class="tips-title">📝 学习建议</view>
    <view class="tips-list">
      <view class="tip-item" wx:for="{{tips}}" wx:key="index">
        <view class="tip-number">{{index + 1}}</view>
        <view class="tip-content">{{item}}</view>
      </view>
    </view>
  </view>
</view>