.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.progress-info {
  display: flex;
  align-items: baseline;
}

.current {
  font-size: 48rpx;
  font-weight: 700;
  color: #667eea;
}

.separator {
  font-size: 32rpx;
  color: #999;
  margin: 0 8rpx;
}

.total {
  font-size: 32rpx;
  color: #999;
}

.score-display {
  display: flex;
  align-items: center;
  background: rgba(102, 126, 234, 0.1);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.score-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.score-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #667eea;
}

.question-section {
  margin-bottom: 40rpx;
}

.question-number {
  font-size: 26rpx;
  color: #667eea;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.question-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.options-list {
  display: flex;
  flex-direction: column;
}

.option-icon {
  font-size: 32rpx;
  font-weight: bold;
}

.option-icon.correct {
  color: #10b981;
}

.option-icon.wrong {
  color: #ef4444;
}

.feedback-section {
  margin-bottom: 40rpx;
}

.feedback-card {
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.feedback-card.correct {
  background: rgba(16, 185, 129, 0.1);
  border: 2rpx solid #10b981;
}

.feedback-card.wrong {
  background: rgba(239, 68, 68, 0.1);
  border: 2rpx solid #ef4444;
}

.feedback-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.feedback-text {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.feedback-card.correct .feedback-text {
  color: #10b981;
}

.feedback-card.wrong .feedback-text {
  color: #ef4444;
}

.feedback-detail {
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.detail-label {
  color: #666;
}

.detail-value {
  color: #10b981;
  font-weight: 600;
}

.feedback-explanation {
  background: rgba(255, 255, 255, 0.8);
  padding: 20rpx;
  border-radius: 12rpx;
}

.explanation-label {
  font-size: 26rpx;
  color: #667eea;
}

.explanation-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.action-section {
  margin-top: 20rpx;
}