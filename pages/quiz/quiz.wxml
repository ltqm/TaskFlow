<view class="container">
  <view class="card">
    <view class="quiz-header">
      <view class="progress-info">
        <text class="current">{{currentIndex + 1}}</text>
        <text class="separator">/</text>
        <text class="total">{{questions.length}}</text>
      </view>
      <view class="score-display">
        <text class="score-icon">⭐</text>
        <text class="score-value">{{score}}</text>
      </view>
    </view>

    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>

    <view class="question-section">
      <view class="question-number">第 {{currentIndex + 1}} 题</view>
      <view class="question-text">{{currentQuestion?.question}}</view>
      
      <view class="options-list">
        <view 
          wx:for="{{currentQuestion?.options}}" 
          wx:key="index"
          class="option-item {{getOptionClass(index)}}"
          bindtap="selectOption"
          data-index="{{index}}"
        >
          <view class="option-letter">{{getOptionLetter(index)}}</view>
          <view class="option-text">{{item}}</view>
          <view wx:if="showResult && index === currentQuestion?.correctIndex" class="option-icon correct">✓</view>
          <view wx:if="showResult && selectedAnswer === index && index !== currentQuestion?.correctIndex" class="option-icon wrong">✗</view>
        </view>
      </view>
    </view>

    <view class="feedback-section" wx:if="showResult">
      <view class="feedback-card {{isCorrect ? 'correct' : 'wrong'}}">
        <view class="feedback-icon">{{isCorrect ? '🎉' : '😅'}}</view>
        <view class="feedback-text">{{isCorrect ? '回答正确！' : '回答错误'}}</view>
        <view class="feedback-detail" wx:if="!isCorrect">
          <text class="detail-label">正确答案：</text>
          <text class="detail-value">{{getOptionLetter(currentQuestion?.correctIndex || 0)}}. {{currentQuestion?.options[currentQuestion?.correctIndex || 0]}}</text>
        </view>
        <view class="feedback-explanation" wx:if="currentQuestion?.explanation">
          <text class="explanation-label">💡 解析：</text>
          <text class="explanation-text">{{currentQuestion?.explanation}}</text>
        </view>
      </view>
    </view>

    <view class="action-section">
      <view 
        wx:if="!showResult" 
        class="btn-primary" 
        bindtap="confirmAnswer"
        style="opacity: {{selectedAnswer !== null ? 1 : 0.5}};"
      >
        {{selectedAnswer !== null ? '确认答案' : '请选择答案'}}
      </view>
      <view 
        wx:else 
        class="btn-primary" 
        bindtap="nextQuestion"
      >
        {{currentIndex < questions.length - 1 ? '下一题' : '查看成绩'}}
      </view>
    </view>
  </view>
</view>